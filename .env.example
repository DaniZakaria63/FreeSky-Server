# =============================================================================
# Freesky Server — environment configuration
# =============================================================================
# Copy to .env and adjust for your environment.
# Never commit .env to version control.
# =============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# Production (Turso remote):
#   TURSO_URL=https://<db-name>-<org>.turso.io
#   TURSO_AUTH_TOKEN=<db-token>         # from `turso db tokens create <db-name>`
#
# Development (local SQLite file):
#   TURSO_URL=file:///path/to/community.db
#   TURSO_AUTH_TOKEN=                   # leave blank for local file
TURSO_URL=
TURSO_AUTH_TOKEN=

# ─── Logging ─────────────────────────────────────────────────────────────────
# When true, enables debug-level logging to stdout + logs/freesky.log file.
# Values: true | false (default: false)
DEBUG=false

# ─── App Authentication ──────────────────────────────────────────────────────
# SHA-1 of the Android APK signing certificate (hex, colons optional).
# Only devices signed with this key can register.
# Get the SHA-1 of your release key:
#   keytool -list -v -keystore release.keystore -alias androidrelease
# Example:
#   TRUSTED_APK_KEY=AB:CD:EF:12:34:56:78:90:AB:CD:EF:12:34:56:78:90:AB:CD:EF:12
TRUSTED_APK_KEY=
