# Freesky Server environment configuration
# Copy to .env and adjust as needed.

# When true, enables debug-level logging to stdout AND writes a session
# log file (freesky.log) in the server working directory.
# Values: true | false (default: false)
DEBUG=false

# Trusted APK signing key SHA-1 (hex, with or without colons).
# Only devices signed with this key can register.
# Get the SHA-1 of your release key via:
#   keytool -list -v -keystore release.keystore -alias androidrelease
# Example:
# TRUSTED_APK_KEY=ABCDEF1234567890ABCDEF1234567890ABCDEF
